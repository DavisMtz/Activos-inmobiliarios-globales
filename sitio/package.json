{
  "name": "activos-inmobiliarios",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sitio y panel de Activos Inmobiliarios Globales (Morelia): React Router + un Worker de Cloudflare + D1.",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false",
    "typecheck": "wrangler types --strict-vars=false && react-router typegen && tsc -b",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply activos-inmobiliarios-db --local",
    "db:remote": "wrangler d1 migrations apply activos-inmobiliarios-db --remote",
    "maestro:crear": "node scripts/crear-maestro.mjs",
    "verificar": "node scripts/verificar.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "hono": "4.13.8",
    "isbot": "5.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.11",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.133.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260916.1": true
  }
}
